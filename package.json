{
  "name": "poppy-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas-based multimodal content workspace. Next.js canvas + local FastAPI engine for ingestion, transcription and LLM generation.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web run start",
    "lint": "npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck",
    "install:web": "npm --prefix web install",
    "dev:engine": "cd engine && python -m uvicorn app:app --reload --port 8000",
    "tunnel": "cloudflared tunnel --url http://localhost:8000"
  }
}
