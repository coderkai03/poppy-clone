# Must match MAC_API_SECRET in web/.env.local
MAC_API_SECRET=change-me-to-a-long-random-string

# tiny | base | small | medium | large-v3 — bigger is slower but more accurate
WHISPER_MODEL=base
# cpu, or cuda on an NVIDIA box
WHISPER_DEVICE=cpu
# int8 is the right choice on CPU; use float16 on cuda
WHISPER_COMPUTE_TYPE=int8

PORT=8000

# Local model server, replacing the old OpenRouter call.
# LM Studio: 1234 | llama-server: 8080 | Ollama: 11434
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# Leave blank to auto-detect whichever model the server has loaded.
LOCAL_LLM_MODEL=
# Caps a single generation. ~1024 keeps a canvas card responsive.
LOCAL_LLM_MAX_TOKENS=1024
LOCAL_LLM_TEMPERATURE=0.6
# Appended to the user message to suppress chain-of-thought. Qwen3 and other
# hybrid reasoning models otherwise burn hundreds of hidden tokens before
# answering (measured: 17-20s vs 4.5s on Qwen3-4B). Empty = let it think.
LOCAL_LLM_PROMPT_SUFFIX=/no_think
