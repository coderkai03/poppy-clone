# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are intentionally un-anchored: the Next app lives in web/, so a
# leading slash would only match at the repo root and miss web/node_modules.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones stay local, the templates are committed
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / engine
__pycache__/
*.py[cod]
venv/
.venv/
