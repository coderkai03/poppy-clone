# The ingestion + generation engine. Use http://localhost:8000 when both halves
# run on this machine; use the *.trycloudflare.com URL when tunnelling.
#
# Generation no longer calls OpenRouter — /api/llm proxies to the engine, which
# talks to a locally hosted model. Configure the model itself in engine/.env
# (LOCAL_LLM_BASE_URL / LOCAL_LLM_MODEL).
MAC_MINI_URL=http://localhost:8000

# Must match MAC_API_SECRET in engine/.env
MAC_API_SECRET=change-me-to-a-long-random-string
